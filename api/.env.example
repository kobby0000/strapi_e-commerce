NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5174
MONGO_URI=mongodb://127.0.0.1:27017/electronics_shop
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_INVITE_CODE=replace-with-private-admin-invite-code
PASSWORD_RESET_CLIENT_URL=http://localhost:5174/password-reset
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15
EMAIL_VERIFICATION_CLIENT_URL=http://localhost:5174/verify-email
EMAIL_VERIFICATION_TOKEN_EXPIRES_MINUTES=60
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CircuitCart <no-reply@circuitcart.local>"
BCRYPT_SALT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25
UPLOAD_MAX_FILE_SIZE_BYTES=2097152
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
